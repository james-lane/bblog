# Required for deployed instances. Choose this yourself during deployment and
# share it only with people who should join this bblog instance.
BBLOG_FAMILY_ACCESS_KEY=

# Optional for online sync on Vercel. Vercel Blob creates this automatically
# when you connect a Blob store. Cloudflare deployments use the BBLOG_BUCKET R2
# binding from wrangler.jsonc instead. Without cloud storage, a configured
# deployment can be used as a single-device local vault. For local `npm run dev`,
# this is not required; the local server stores encrypted vault files in
# .local/vaults.
BLOB_READ_WRITE_TOKEN=

# Optional on Vercel for medication reminders while an installed PWA is closed.
# Generate these with `npm run notifications:keys`, then add them to the
# deployed environment alongside Vercel Blob. Cloudflare deployments currently
# support in-app reminders only.
BBLOG_VAPID_PUBLIC_KEY=
BBLOG_VAPID_PRIVATE_KEY=
BBLOG_VAPID_SUBJECT=mailto:you@example.com
