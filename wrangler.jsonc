{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bblog",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "BBLOG_BUCKET",
      "bucket_name": "bblog-vault"
    }
  ]
}
